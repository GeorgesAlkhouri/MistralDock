# Required secrets. Copy to .env and fill locally; never commit .env.
PAPERLESS_URL=https://paperless.example
PAPERLESS_TOKEN=
MISTRAL_API_KEY=
MISTRALDOCK_API_TOKEN=

# Safe default: calculate and record proposals without PATCHing Paperless.
WRITE_MODE=dry-run
PAPERLESS_API_VERSION=9
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_METADATA_MODEL=mistral-small-latest
DATABASE_URL=sqlite:////data/mistraldock.db
